# ------------------------------------------------------------------
# Contact form e-mail (SMTP via SiteGround)
# Add these in Vercel: Project > Settings > Environment Variables.
# For local testing, copy this file to `.env.local` and fill it in.
# ------------------------------------------------------------------

# SiteGround SMTP host — usually mail.<yourdomain> (e.g. mail.navisol.nl)
# or the outgoing server shown in SiteGround > Email > Accounts > Mail configuration.
SMTP_HOST=mail.navisol.nl

# 465 for SSL (recommended) or 587 for STARTTLS.
SMTP_PORT=465

# A real mailbox you create in SiteGround to send from.
SMTP_USER=website@navisol.nl

# That mailbox's password.
SMTP_PASS=your-mailbox-password

# Optional: the visible "from" address (defaults to SMTP_USER).
CONTACT_FROM=website@navisol.nl

# Optional: override recipients (comma-separated). Defaults to these three.
CONTACT_TO=sales@navisol.nl, info@navisol.nl, erik@navisol.nl

# ------------------------------------------------------------------
# Monthly test email (Vercel Cron -> /api/cron/test-email)
# ------------------------------------------------------------------
# A long random string. Set the SAME value in Vercel so only Vercel Cron
# can trigger the monthly test endpoint.
CRON_SECRET=change-me-to-a-long-random-string

# Optional: where the monthly test email goes (defaults to CONTACT_TO).
TEST_EMAIL_TO=info@navisol.nl
